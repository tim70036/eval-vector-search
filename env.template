# Databricks Configuration
EVAL_DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
EVAL_DATABRICKS_TOKEN=  # Optional if using DATABRICKS_CONFIG_PROFILE

# Vector Search Configuration
EVAL_VECTOR_SEARCH_ENDPOINT=aigc-vector-search-endpoint

# MLflow Configuration
EVAL_MLFLOW_EXPERIMENT_NAME=/Users/your.email@company.com/vector-search-evaluation
EVAL_MLFLOW_MAX_WORKERS=3  # Maximum number of workers for MLflow evaluation. Prevent overloading the LLM judge endpoint.
EVAL_MLFLOW_MAX_SCORER_WORKERS=3  # Maximum number of workers for running scorers/judges in parallel. Controls concurrency for scorer execution to prevent overloading the LLM judge endpoint.

# LLM Judge Configuration
EVAL_DATABRICKS_LLM_JUDGE_ENDPOINT=databricks-meta-llama-3-1-70b-instruct

# Evaluation Configuration
EVAL_NUM_RESULTS=10  # Number of results to retrieve per query

# Agent API Configuration (Optional)
EVAL_AGENT_API_ENDPOINT=  # Agent API endpoint URL (optional, can also be configured in SOURCE_CONFIGS)
EVAL_AGENT_API_TIMEOUT=30  # Request timeout in seconds

# Recommend Products API Configuration (Optional)
EVAL_RECOMMEND_PRODUCTS_API_ENDPOINT=https://agent.aigc.mlytics.co/api/v1/recommend-products
EVAL_RECOMMEND_PRODUCTS_API_TOKEN=  # Bearer token for authentication
EVAL_RECOMMEND_PRODUCTS_CUSTOMER_UUID=  # Customer UUID for API requests

# Gemini Embeddings Configuration (Optional)
EVAL_GEMINI_API_KEY=  # Your Gemini API key
EVAL_GEMINI_EMBED_MODEL=  # e.g., models/embedding-001 or gemini-embedding-001 (Note: text-embedding-004 was shut down Jan 14, 2026)
